{
  "name": "aica-site-preview",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test",
    "preview": "node scripts/preview.mjs",
    "preview:data": "node scripts/preview-data.mjs --write",
    "check:preview-data": "node scripts/preview-data.mjs --check",
    "check:public": "npm run check && npm run check:preview-data"
  }
}
